{% comment %}
  Unified references entry renderer with table grid layout
{% endcomment %}
<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-1 col-sm-1 col-md-1 text-center" style="padding-top: 8px;">
          {% if entry.icon %}
            <i class="{{ entry.icon }}" style="font-size: 1.5rem; color: #0066cc;"></i>
          {% endif %}
        </div>
        <div class="col-xs-11 col-sm-11 col-md-11" style="padding-left: 20px;">
          <h6 class="title font-weight-bold" style="margin-bottom: 4px; margin-top: 0;">{{ entry.name }}</h6>
          <div style="line-height: 1.7; color: #555;">
            <span style="font-weight: 600; color: #030303;">{{ entry.role }}</span> | 
            <span>{{ entry.affiliation }}</span> | 
            <span>{{ entry.profile | markdownify | remove: '<p>' | remove: '</p>' }}</span>
          </div>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>